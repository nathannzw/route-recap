# Google Maps Platform API key (Directions/Routes, Snap to Roads, Geocoding).
# If unset, the pipeline falls back to OSRM (routing) and Nominatim (geocoding).
GOOGLE_MAPS_API_KEY=

# Nominatim reverse-geocoding User-Agent (required by the OSM usage policy).
NOMINATIM_USER_AGENT=route-recap/0.1 (personal use)

# Optional: explicit path to the ExifTool executable
# (e.g. EXIFTOOL_PATH=C:\Tools\exiftool.exe). Detected from PATH by default.
EXIFTOOL_PATH=

# Optional: override the OSRM server used as the routing fallback.
OSRM_BASE_URL=https://router.project-osrm.org
