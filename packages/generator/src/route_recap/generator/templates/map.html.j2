          if (hadHidden && track.length) {
            var lastPt = track[track.length - 1];
            track.push({ v: lastPt.v, lat: lastPt.lat, lon: lastPt.lon, km: lastPt.km, day: lastPt.day, pi: pathIndex - 1 });
            track.push({ v: lastPt.v, lat: coords[0][0], lon: coords[0][1], km: lastPt.km, day: day, pi: pathIndex, teleport: true });
            hadHidden = false;
          }
          var coordPi = appendCoords(coords, day);
          var dists = [], totalD = 0;
          for (var i = 1; i < coords.length; i++) {
            var d = map.distance(coords[i - 1], coords[i]);
            dists.push(d); totalD += d;
          }
          var cum = 0;
          for (var j = 0; j < coords.length; j++) {
            if (j > 0) cum += dists[j - 1];
            track.push({ v: km + cum / 1000, lat: coords[j][0], lon: coords[j][1], km: km + cum / 1000, day: day, pi: coordPi[j] });
          }
          km += totalD / 1000;
        });
        return { mode: 'dist', track: track, max: Math.max(km, 1), t0: 0, routePath: routePath, routeDays: routeDays };
      }

      // Place arrows at an even distance interval along the whole route, so
      // spacing is consistent regardless of how the route is split into
      // segments (per-segment placement used to bunch arrows on short legs and
      // leave long legs bare). Kept deliberately sparse (~one per 60 km on a
      // country-scale trip) so the route stays legible.
      var ARROW_TARGET = 34;
      var ARROW_MIN_SPACING_KM = 3;
      var ARROW_MAX_SPACING_KM = 60;
      function addArrows() {
        var path = anim && anim.routePath, days = anim && anim.routeDays;
        if (!path || path.length < 2) return;
        var cum = [0];
        for (var i = 1; i < path.length; i++) {
          cum.push(cum[i - 1] + map.distance(path[i - 1], path[i]));
        }
        var total = cum[cum.length - 1];
        if (total <= 0) return;
        var spacingKm = Math.min(ARROW_MAX_SPACING_KM,
          Math.max(ARROW_MIN_SPACING_KM, (total / 1000) / ARROW_TARGET));
        var spacing = spacingKm * 1000;
        var cap = 140, placed = 0;
        for (var target = spacing; target < total && placed < cap; target += spacing) {
          var lo = 0, hi = cum.length - 1;
          while (hi - lo > 1) {
            var mid = (lo + hi) >> 1;
            if (cum[mid] <= target) lo = mid; else hi = mid;
          }
          if (lo < 1) continue;
          var day = (days && days[lo] != null) ? days[lo] : 0;
          if (visibleDays[day] === false) continue;
          var a = path[lo - 1], b = path[lo];
          var segLen = cum[lo] - cum[lo - 1];
          var f = segLen > 0 ? (target - cum[lo - 1]) / segLen : 0;
          var lat = a[0] + (b[0] - a[0]) * f;
          var lon = a[1] + (b[1] - a[1]) * f;
          var bearing = bearingDeg({ lat: a[0], lon: a[1] }, { lat: b[0], lon: b[1] });
          var ic = L.divIcon({
            className: 'dir-arrow', html: arrowSvg(dayColor(day), bearing),
            iconSize: [15, 15], iconAnchor: [7.5, 7.5]
          });
          var m = L.marker([lat, lon], { icon: ic, interactive: false });
          if (staticRouteVisible) m.addTo(map);
          arrowMarkers.push(m);
          placed++;
        }
      }

      var anim = null;
      var car = null;
      var arrowMarkers = [];
      var rafId = null;

      var controls = document.getElementById('anim-controls');
      var playBtn = document.getElementById('anim-play');
      var speedSel = document.getElementById('anim-speed');
      var slider = document.getElementById('anim-slider');
      var labelMain = document.getElementById('anim-label-main');
      var labelSub = document.getElementById('anim-label-sub');

      function posAt(v) {
        var t = anim.track;
        if (v <= t[0].v) return { v: t[0].v, lat: t[0].lat, lon: t[0].lon, a: t[0], b: t[0], lo: 0, km: t[0].km, pi: t[0].pi, day: t[0].day, realMs: t[0].realMs };
        if (v >= t[t.length - 1].v) {
          var e = t[t.length - 1];
          return { v: e.v, lat: e.lat, lon: e.lon, a: e, b: e, lo: t.length - 1, km: e.km, pi: e.pi, day: e.day, realMs: e.realMs };
        }
        var lo = 0, hi = t.length - 1;
        while (hi - lo > 1) {
          var mid = (lo + hi) >> 1;
          if (t[mid].v <= v) lo = mid; else hi = mid;
        }
        var a = t[lo], b = t[hi];
        if (a.v === b.v) {
          // Stop-hold or teleport: snap to the later point.
          return { v: v, lat: b.lat, lon: b.lon, a: a, b: b, lo: lo, km: b.km, pi: b.pi, day: b.day, realMs: b.realMs };
        }
        var span = (b.v - a.v) || 1;
        var f = (v - a.v) / span;
        var realMs = (a.realMs != null && b.realMs != null)
          ? a.realMs + (b.realMs - a.realMs) * f : null;
        return { v: v, lat: a.lat + (b.lat - a.lat) * f, lon: a.lon + (b.lon - a.lon) * f, a: a, b: b, lo: lo, km: a.km + (b.km - a.km) * f, pi: a.pi, day: a.day, realMs: realMs };
      }

      var carIcon = L.divIcon({
        className: 'car-icon',
        html: CAR_SVG,
        iconSize: [48, 26],
        iconAnchor: [24, 13],
        popupAnchor: [0, -15]
      });

      function haversineKm(aLat, aLon, bLat, bLon) {
        var R = 6371.0088;
        var p1 = aLat * Math.PI / 180, p2 = bLat * Math.PI / 180;
        var dp = (bLat - aLat) * Math.PI / 180, dl = (bLon - aLon) * Math.PI / 180;
        var h = Math.sin(dp / 2) * Math.sin(dp / 2) + Math.cos(p1) * Math.cos(p2) * Math.sin(dl / 2) * Math.sin(dl / 2);
        return 2 * R * Math.asin(Math.sqrt(h));
      }
      function fmtKm(km) {
        if (data.unit === 'mi') return (km / 1.609344).toFixed(1) + ' mi';
        return km.toFixed(1) + ' km';
      }
      function nextStopInfo(p) {
        var stops = data.stops || [];
        if (!stops.length) return null;
        // Compare against the track point's REAL timestamp, not the (paced)
        // animation clock, so At/Next stays honest.
        var nowMs = (anim.mode === 'time' && p.realMs != null) ? p.realMs : null;
        var best = null;
        for (var i = 0; i < stops.length; i++) {
          var s = stops[i];
          var dist = haversineKm(p.lat, p.lon, s.latitude, s.longitude);
          var name = s.name || ('Stop ' + (i + 1));
          if (nowMs !== null && s.arrived_at) {
            var arr = Date.parse(s.arrived_at);
            var dep = s.departed_at ? Date.parse(s.departed_at) : arr;
            if (nowMs >= arr && nowMs <= dep) return { at: true, name: name, dist: dist };
            if (arr > nowMs && (!best || arr < best.arr)) best = { at: false, name: name, dist: dist, arr: arr };
          } else if (!best || dist < best.dist) {
            best = { at: false, name: name, dist: dist };
          }
        }
        return best;
      }
      function animLabel(p) {
        var main, sub = '';
        if (anim.mode === 'time') {
          var ms = (p.realMs != null) ? p.realMs : anim.t0 + anim.current * 1000;
          var d = new Date(ms);
          var day = (p.day == null ? 0 : p.day) + 1;
          main = '<span style="color:' + dayColor(p.day) + ';font-weight:700">Day ' + day + '</span> · '
            + pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ' · ' + fmtKm(p.km);
        } else {
          main = fmtKm(p.km);
        }
        var ns = nextStopInfo(p);
        if (ns) sub = ns.at ? 'At: ' + ns.name : 'Next: ' + ns.name + ' · ' + fmtKm(ns.dist);
        return { main: main, sub: sub };
      }
      function stepPerSec() { return anim.max * anim.pct / 100; }
      // Reveal the geometry behind the car, colored by the day it belongs to.
      // routePath is split into contiguous per-day "runs"; a run's polyline is
      // extended as the car advances and dropped again if it is scrubbed back.
      function renderTrail(p) {
        var k = Math.max(0, Math.min(p.pi, anim.routePath.length - 1));
        for (var r = 0; r < anim.trailRuns.length; r++) {
          var run = anim.trailRuns[r];
          var want = k >= run.start ? Math.min(k, run.end) - run.start + 1 : 0;
          if (want === run.drawn) continue;
          run.drawn = want;
          if (want < 2) {
            if (run.polyline) { map.removeLayer(run.polyline); run.polyline = null; }
            continue;
          }
          var pts = anim.routePath.slice(run.start, run.start + want);
          // Extend the run's tip to the car's live position.
          if (k >= run.start && k <= run.end) pts.push([p.lat, p.lon]);
          if (!run.polyline) {
            run.polyline = L.polyline(pts, {
              color: dayColor(run.day), weight: 5.5, opacity: 0.98,
              lineJoin: 'round', lineCap: 'round'
            }).addTo(map);
          } else {
            run.polyline.setLatLngs(pts);
          }
        }
      }
      function syncAnim() {
        var p = posAt(anim.current);
        car.setLatLng([p.lat, p.lon]);
        // The car stays upright on screen; travel direction is shown by the
        // arrows. While driving, the full route is hidden and only what the
        // car has already covered is drawn, so the line grows in behind it.
        var driving = anim.playing || anim.current > 0;
        setStaticRouteVisible(!driving);
        var k = Math.max(0, Math.min(p.pi, anim.routePath.length - 1));
        if (k !== anim.lastK || anim.dragging) {
          anim.lastK = k;
          renderTrail(p);
        }
        var lbl = animLabel(p);
        labelMain.innerHTML = lbl.main;
        labelSub.textContent = lbl.sub;
        if (!anim.dragging) slider.value = Math.round(anim.current / anim.max * 1000);
      }
      function frame(now) {
        if (!anim.playing) { rafId = null; return; }
        if (anim.lastFrame === null) anim.lastFrame = now;
        var dt = (now - anim.lastFrame) / 1000;
        anim.lastFrame = now;
        anim.current += dt * stepPerSec();
        if (anim.current >= anim.max) {
          anim.current = anim.max;
          anim.playing = false;
          playBtn.textContent = '▶';
        }
        syncAnim();
        rafId = requestAnimationFrame(frame);
      }

      function clearArrows() {
        arrowMarkers.forEach(function (m) { map.removeLayer(m); });
        arrowMarkers = [];
      }
      // Toggle the whole static route (day polylines + arrows) as one unit.
      function setStaticRouteVisible(visible) {
        if (visible === staticRouteVisible) return;
        staticRouteVisible = visible;
        for (var day in dayLayers) {
          var show = visible && visibleDays[day] !== false;
          dayLayers[day].forEach(function (p) {
            if (show) { if (!map.hasLayer(p)) p.addTo(map); }
            else p.remove();
          });
        }
        arrowMarkers.forEach(function (m) {
          if (visible) { if (!map.hasLayer(m)) m.addTo(map); }
          else map.removeLayer(m);
        });
      }
      // (Re)build the animation from the currently visible days. Called once
      // on load and again whenever a day is toggled in the legend.
      function setupAnimation() {
        clearArrows();
        if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
        if (car) { map.removeLayer(car); car = null; }
        if (anim && anim.trailRuns) {
          anim.trailRuns.forEach(function (run) {
            if (run.polyline) map.removeLayer(run.polyline);
          });
        }
        var info = buildTrack();
        if (!info || info.track.length < 2) {
          anim = null;
          controls.style.display = 'none';
          setStaticRouteVisible(true);
          return;
        }
        // Split the driven geometry into contiguous per-day runs.
        var trailRuns = [];
        for (var i = 0; i < info.routeDays.length; i++) {
          var last = trailRuns[trailRuns.length - 1];
          if (!last || last.day !== info.routeDays[i]) {
            trailRuns.push({ day: info.routeDays[i], start: i, end: i, drawn: 0, polyline: null });
          } else {
            last.end = i;
          }
        }
        anim = {
          track: info.track,
          mode: info.mode,
          t0: info.t0,
          max: info.max,
          routePath: info.routePath,
          routeDays: info.routeDays,
          trailRuns: trailRuns,
          current: 0,
          pct: parseFloat(speedSel.value) || 1,
          playing: false,
          dragging: false,
          lastFrame: null,
          lastK: -1
        };
        car = L.marker([anim.track[0].lat, anim.track[0].lon], { icon: carIcon, zIndexOffset: 1000 }).addTo(map);
        addArrows();
        controls.style.display = 'flex';
        playBtn.textContent = '▶';
        syncAnim();
      }

      playBtn.addEventListener('click', function () {
        anim.playing = !anim.playing;
        playBtn.textContent = anim.playing ? '⏸' : '▶';
        if (anim.playing) {
          if (anim.current >= anim.max) anim.current = 0;
          anim.lastFrame = null;
          rafId = requestAnimationFrame(frame);
        }
        syncAnim();
      });
      // Restart the drive from the beginning: stop, clear the revealed trail,
      // and bring the full route overview back.
      var resetBtn = document.getElementById('anim-reset');
      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          if (!anim) return;
          anim.playing = false;
          playBtn.textContent = '▶';
          if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
          anim.current = 0;
          anim.lastFrame = null;
          anim.lastK = -1;
          anim.trailRuns.forEach(function (run) {
            if (run.polyline) { map.removeLayer(run.polyline); run.polyline = null; }
            run.drawn = 0;
          });
          syncAnim();
          toast('Back to the start of the journey');
        });
      }
      speedSel.addEventListener('change', function () { anim.pct = parseFloat(speedSel.value); });
      slider.addEventListener('input', function () {
        anim.dragging = true;
        anim.current = slider.value / 1000 * anim.max;
        syncAnim();
        anim.dragging = false;
      });

      // ---- mobile: swipe up/down on the map to change speed ----
      var SPEEDS = [0.02, 0.05, 0.1, 0.25, 1, 4, 16];
      var touchY = null, touchX = null, touchT = null;
      var mapEl = document.getElementById('map');
      mapEl.addEventListener('touchstart', function (e) {
        if (e.touches.length !== 1) { touchY = null; return; }
        touchY = e.touches[0].clientY;
        touchX = e.touches[0].clientX;
        touchT = Date.now();
      }, { passive: true });
      mapEl.addEventListener('touchend', function (e) {
        if (touchY === null || !anim) return;
        var dy = e.changedTouches[0].clientY - touchY;
        var dx = e.changedTouches[0].clientX - touchX;
        var dt = Date.now() - touchT;
        touchY = null;
        if (dt > 700 || Math.abs(dy) < 50 || Math.abs(dy) < Math.abs(dx) * 1.5) return;
        var idx = SPEEDS.indexOf(parseFloat(speedSel.value));
        if (idx < 0) idx = 4;
        idx = dy < 0 ? Math.min(idx + 1, SPEEDS.length - 1) : Math.max(idx - 1, 0);
        speedSel.value = String(SPEEDS[idx]);
        anim.pct = SPEEDS[idx];
        toast('Speed: ' + speedSel.options[speedSel.selectedIndex].text);
      }, { passive: true });

      // Tap the label to play / pause.
      var labelBox = document.getElementById('anim-label');
      if (labelBox) {
        labelBox.addEventListener('click', function () {
          if (anim) playBtn.click();
        });
      }

      setupAnimation();

      if (bounds.length) {
        map.fitBounds(L.latLngBounds(bounds), { padding: [40, 40], maxZoom: 14 });
      } else {
        var note = document.createElement('div');
        note.className = 'empty-note';
        note.textContent = 'No geotagged route data found for this trip.';
        document.getElementById('map').appendChild(note);
      }
    })();
  </script>
</body>
</html>
