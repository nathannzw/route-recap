<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <title>{{ trip_name }} · route-recap</title>
{% if vendor_css %}
  <style>{{ vendor_css | safe }}</style>
{% else %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
{% endif %}
  <script>
    // Apply the saved/preferred theme before first paint (avoids a light flash).
    (function () {
      try {
        var stored = localStorage.getItem('route-recap-theme');
        var dark = stored ? stored === 'dark'
          : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.classList.add('dark');
      } catch (e) {}
    })();
  </script>
  <style>
    :root {
      color-scheme: light;
      --ink: #10243e;
      --muted: #5b6b81;
      --brand: #157a8c;
      --brand-deep: #0b2f5b;
      --accent: #ff6b4a;
      --card: #ffffff;
      --bg: #f4f6fb;
      --border: #e6eaf2;
      --field: #ffffff;
      --hover: #f2f6fc;
      --shadow: rgba(16, 36, 62, 0.2);
      --halo: rgba(255, 255, 255, 0.85);
    }
    html.dark {
      color-scheme: dark;
      --ink: #e7eef8;
      --muted: #9cb0c8;
      --brand: #38c6d9;
      --brand-deep: #08131f;
      --accent: #ff8a66;
      --card: #16202d;
      --bg: #0a1017;
      --border: #26313f;
      --field: #1b2634;
      --hover: #202d3d;
      --shadow: rgba(0, 0, 0, 0.55);
      --halo: rgba(6, 12, 20, 0.78);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; }
    /* iOS Safari: stop it inflating text in landscape. */
    html { -webkit-text-size-adjust: 100%; }
    body {
      font-family: "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, sans-serif;
      background: var(--bg);
      color: var(--ink);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      /* dvh tracks the collapsing Safari toolbar so the controls stay put. */
      min-height: 100dvh;
    }
    header {
      background: linear-gradient(120deg, var(--brand-deep) 0%, var(--brand) 90%);
      color: #fff;
      /* env() keeps content clear of the notch / Dynamic Island. */
      padding: calc(20px + env(safe-area-inset-top)) calc(24px + env(safe-area-inset-right))
        20px calc(24px + env(safe-area-inset-left));
      box-shadow: 0 2px 14px rgba(11, 47, 91, 0.25);
    }
    .banner-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 20px 32px;
      align-items: flex-end;
      justify-content: space-between;
    }
    .title-block h1 {
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }
    .title-block .sub {
      margin-top: 6px;
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.78);
    }
    .stats {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .stat {
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 12px;
      padding: 10px 16px;
      min-width: 96px;
      text-align: center;
      backdrop-filter: blur(4px);
    }
    .stat .value {
      display: block;
      font-size: 1.15rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .stat .label {
      display: block;
      margin-top: 2px;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: rgba(255, 255, 255, 0.75);
    }
    #map {
      flex: 1;
      min-height: 420px;
      width: 100%;
      /* Match the theme so the area beyond the tiles isn't Leaflet's grey. */
      background: var(--bg);
    }
    .map-wrap { position: relative; flex: 1; display: flex; min-height: 420px; }
    footer {
      padding: 10px calc(24px + env(safe-area-inset-right))
        calc(10px + env(safe-area-inset-bottom)) calc(24px + env(safe-area-inset-left));
      font-size: 0.72rem;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 6px;
      background: var(--card);
      border-top: 1px solid var(--border);
    }
    /* stop pins */
    .stop-pin-wrap { background: transparent; border: none; }
    .stop-pin {
      width: 30px;
      height: 30px;
      border-radius: 50% 50% 50% 0;
      transform: rotate(-45deg);
      background: var(--accent);
      border: 2px solid #fff;
      box-shadow: 0 2px 8px rgba(16, 36, 62, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.85rem;
      color: #fff;
    }
    .stop-pin span { transform: rotate(45deg); }
    /* popup */
    .leaflet-popup-content-wrapper {
      border-radius: 12px;
      box-shadow: 0 6px 24px rgba(16, 36, 62, 0.22);
    }
    .stop-popup h3 {
      font-size: 1rem;
      color: var(--ink);
      margin-bottom: 4px;
    }
    .stop-popup .addr {
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .stop-popup .times {
      font-size: 0.78rem;
      color: var(--brand);
      font-weight: 600;
      margin-bottom: 2px;
    }
    .stop-popup .count { font-size: 0.78rem; color: var(--muted); }
    .photo-strip { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
    .photo-strip a { display: block; }
    .photo-strip img {
      width: 56px;
      height: 56px;
      object-fit: cover;
      border-radius: 6px;
      border: 2px solid #fff;
      box-shadow: 0 1px 4px rgba(16, 36, 62, 0.25);
      transition: transform 0.12s ease;
    }
    .photo-strip img:hover { transform: scale(1.08); }
    .photo-strip .vid {
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--brand-deep);
      color: #fff;
      font-size: 1.1rem;
      border-radius: 6px;
      text-decoration: none;
    }
    /* Photos open in an in-page lightbox rather than a new tab. */
    .photo-strip button.photo-open {
      display: block; padding: 0; border: none; background: none;
      cursor: zoom-in; line-height: 0;
    }
    .photo-strip button.photo-more {
      width: 56px; height: 56px; border-radius: 6px;
      background: rgba(16, 36, 62, 0.78); color: #fff;
      font-weight: 700; font-size: 0.78rem; cursor: pointer;
    }
    .photo-strip button.photo-more:hover { background: var(--brand-deep); }
    /* lightbox */
    .lightbox {
      position: fixed; inset: 0; z-index: 3000;
      background: rgba(6, 12, 20, 0.9);
      display: flex; align-items: center; justify-content: center;
      padding: calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right))
               calc(16px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left));
    }
    .lightbox[hidden] { display: none; }
    .lightbox img {
      max-width: 100%; max-height: 100%;
      object-fit: contain; border-radius: 8px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
      background: rgba(0, 0, 0, 0.35);
    }
    .lightbox button {
      position: absolute; border: none; cursor: pointer;
      background: rgba(255, 255, 255, 0.16); color: #fff;
      width: 44px; height: 44px; border-radius: 50%;
      font-size: 1.35rem; line-height: 1;
      display: flex; align-items: center; justify-content: center;
    }
    .lightbox button:hover { background: rgba(255, 255, 255, 0.32); }
    .lightbox button[hidden] { display: none; }
    .lightbox-close { top: calc(12px + env(safe-area-inset-top)); right: calc(12px + env(safe-area-inset-right)); }
    .lightbox-prev { left: 12px; top: 50%; transform: translateY(-50%); }
    .lightbox-next { right: 12px; top: 50%; transform: translateY(-50%); }
    .lightbox-count {
      position: absolute; left: 50%; transform: translateX(-50%);
      bottom: calc(14px + env(safe-area-inset-bottom));
      color: rgba(255, 255, 255, 0.85); font-size: 0.78rem;
    }
    .lightbox-caption {
      position: absolute; left: 50%; transform: translateX(-50%);
      bottom: calc(34px + env(safe-area-inset-bottom));
      color: #fff; font-size: 0.85rem; font-weight: 600;
      max-width: 80vw; text-align: center; white-space: nowrap;
      overflow: hidden; text-overflow: ellipsis;
    }
    /* legend */
    .legend {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 1000;
      background: var(--card);
      border-radius: 10px;
      box-shadow: 0 2px 10px var(--shadow);
      padding: 8px 12px;
      font-size: 0.75rem;
      color: var(--ink);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .legend span { display: flex; align-items: center; gap: 6px; }
    .legend .swatch { display: inline-block; width: 12px; height: 12px; border-radius: 50%; flex: none; }
    .legend .swatch.stop { width: 10px; height: 10px; border-radius: 2px; background: var(--accent); }
    .legend .swatch.dir { width: 0; height: 0; border: none; border-radius: 0; border-left: 8px solid var(--muted); border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
    .legend .swatch.cluster {
      width: 14px; height: 14px; border-radius: 50%;
      background: rgba(21, 122, 140, 0.22); border: 1px solid var(--brand);
    }
    .legend .swatch-icon { font-style: normal; font-size: 12px; line-height: 1; width: 14px; text-align: center; flex: none; }
    .legend-title { font-weight: 700; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
    .day-toggles { display: flex; flex-wrap: wrap; gap: 4px; max-width: 230px; }
    .day-toggle {
      display: inline-flex; align-items: center; gap: 5px;
      border: 1px solid var(--border); background: var(--card); border-radius: 999px;
      padding: 3px 9px; font-size: 0.7rem; font-weight: 600; color: var(--ink);
      cursor: pointer; transition: opacity 0.15s ease, background 0.15s ease;
    }
    .day-toggle:hover { background: var(--hover); }
    .day-toggle.off { opacity: 0.35; text-decoration: line-through; }
    .day-toggle .swatch { width: 10px; height: 10px; border-radius: 50%; flex: none; }
    /* share actions */
    .share-actions { display: flex; gap: 8px; }
    .share-actions button {
      border: 1px solid rgba(255, 255, 255, 0.35);
      background: rgba(255, 255, 255, 0.12);
      color: #fff; border-radius: 999px; padding: 7px 14px;
      font-size: 0.78rem; font-weight: 600; cursor: pointer;
      transition: background 0.15s ease;
    }
    .share-actions button:hover { background: rgba(255, 255, 255, 0.25); }
    /* toast */
    .toast {
      position: fixed; left: 50%; bottom: 84px;
      transform: translateX(-50%) translateY(8px);
      background: rgba(16, 36, 62, 0.92); color: #fff;
      padding: 8px 16px; border-radius: 999px; font-size: 0.78rem;
      z-index: 2000; opacity: 0; pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    /* animation controls */
    .anim-controls {
      position: absolute;
      left: 50%;
      /* Cleared above the iOS home indicator. */
      bottom: calc(14px + env(safe-area-inset-bottom));
      transform: translateX(-50%);
      z-index: 1000;
      background: var(--card);
      border-radius: 12px;
      box-shadow: 0 2px 12px var(--shadow);
      padding: 8px 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.78rem;
      color: var(--ink);
    }
    .anim-controls button {
      border: none;
      background: var(--brand);
      color: #fff;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 0.85rem;
      line-height: 1;
      flex: none;
    }
    .anim-controls button:hover { background: var(--brand-deep); }
    .anim-controls select {
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 3px 6px;
      font-size: 0.72rem;
      color: var(--ink);
      background: var(--field);
    }
    .anim-controls input[type="range"] {
      width: 170px;
      accent-color: var(--brand);
    }
    .anim-controls #anim-label { min-width: 150px; text-align: center; display: flex; flex-direction: column; gap: 1px; }
    .anim-controls .anim-label-main { font-weight: 600; white-space: nowrap; }
    .anim-controls .anim-label-sub { font-size: 0.68rem; color: var(--muted); white-space: nowrap; }
    .car-icon .car-body { filter: drop-shadow(0 3px 5px rgba(16, 36, 62, 0.4)); transform-origin: center; will-change: transform; }
    .dir-arrow { background: transparent; border: none; }
    .dir-arrow svg { filter: drop-shadow(0 0 2px var(--halo)); }
    /* empty state */
    .empty-note {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 1000;
      background: var(--card);
      border-radius: 12px;
      box-shadow: 0 6px 24px var(--shadow);
      padding: 14px 20px;
      font-size: 0.9rem;
      color: var(--muted);
      pointer-events: none;
    }
    /* POI icons (waypoints / off-road spots) */
    .poi-icon-wrap { background: transparent; border: none; }
    .poi-icon {
      display: flex; align-items: center; justify-content: center;
      width: 24px; height: 24px; font-size: 17px; line-height: 1;
      filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5));
    }
    /* Off-road spots are rare, so make them read louder than the 📷 pins. */
    .poi-icon.offroad {
      font-size: 21px;
      filter: drop-shadow(0 0 3px var(--halo)) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
    }
    .anim-controls button.reset { background: var(--muted); }
    .anim-controls button.reset:hover { background: var(--brand-deep); }
    /* Dark-mode polish for Leaflet's own UI */
    html.dark .leaflet-popup-content-wrapper,
    html.dark .leaflet-popup-tip { background: var(--card); color: var(--ink); }
    html.dark .leaflet-bar a,
    html.dark .leaflet-control-attribution { background: var(--card); color: var(--ink); border-color: var(--border); }
    html.dark .marker-cluster-small,
    html.dark .marker-cluster-medium,
    html.dark .marker-cluster-large { background: rgba(56, 198, 217, 0.28); }
    html.dark .marker-cluster div { background: rgba(16, 26, 38, 0.92); color: var(--ink); }
    html.dark .stop-pin { border-color: rgba(10, 16, 23, 0.9); }
    /* Without a CARTO key there is no dark basemap style, so invert OSM tiles. */
    html.dark .tiles-fallback .leaflet-tile-pane {
      filter: invert(1) hue-rotate(180deg) brightness(0.93) contrast(0.9) saturate(0.6);
    }
    @media (max-width: 640px) {
      header {
        padding: calc(14px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right))
          14px calc(16px + env(safe-area-inset-left));
      }
      .title-block h1 { font-size: 1.25rem; }
      .stat { min-width: 72px; padding: 8px 10px; }
      .stat .value { font-size: 1rem; }
      .anim-controls { gap: 6px; padding: 6px 8px; }
      .anim-controls input[type="range"] { width: 100px; }
      .anim-controls #anim-label { min-width: 110px; }
      .anim-controls button { width: 40px; height: 40px; font-size: 1rem; }
      .share-actions button { padding: 8px 12px; font-size: 0.72rem; }
      .day-toggles { max-width: 100%; }
      .legend { max-height: 42vh; overflow-y: auto; }
    }
  </style>
</head>
<body>
  <header>
    <div class="banner-inner">
      <div class="title-block">
        <h1>{{ trip_name }}</h1>
        <p class="sub">{{ date_range }} · generated {{ generated_at }}</p>
      </div>
      <div class="stats">
        <div class="stat"><span class="value">{{ distance_display }}</span><span class="label">Distance</span></div>
        <div class="stat"><span class="value">{{ driving_display }}</span><span class="label">Driving</span></div>
        <div class="stat"><span class="value">{{ stop_duration_display }}</span><span class="label">Stop Time</span></div>
        <div class="stat"><span class="value">{{ stop_count }}</span><span class="label">Stops</span></div>
        {% if off_road_count %}<div class="stat"><span class="value">{{ off_road_count }}</span><span class="label">Off-road</span></div>{% endif %}
        <div class="stat"><span class="value">{{ media_count }}</span><span class="label">Media</span></div>
      </div>
      <div class="share-actions">
        <button id="btn-theme" type="button" title="Toggle dark mode">🌙 Dark</button>
        <button id="btn-share" type="button" title="Copy a link to this report">🔗 Share</button>
        <button id="btn-download" type="button" title="Download this report as a single HTML file">⬇ Download</button>
      </div>
    </div>
  </header>

  <div class="map-wrap">
    <div id="map"></div>
    <div class="legend">
      <span class="legend-title">Days · {{ day_count }}</span>
      <div class="day-toggles" id="day-toggles"></div>
      <span><i class="swatch-icon">📷</i> Waypoint</span>
      <span><i class="swatch-icon">🏔️</i> Off-road spot</span>
      <span><i class="swatch stop"></i> Stop · numbered pin</span>
      <span><i class="swatch cluster"></i> Cluster · nearby photos</span>
      <span><i class="swatch dir"></i> Direction</span>
    </div>
    <div class="anim-controls" id="anim-controls" style="display:none">
      <button id="anim-play" title="Play / pause">▶</button>
      <button id="anim-reset" class="reset" title="Restart the journey from the beginning">⟲</button>
      <select id="anim-speed" title="Animation speed">
        <option value="0.02">Crawl</option>
        <option value="0.05">Very Slow</option>
        <option value="0.1">Slow</option>
        <option value="0.25">Relaxed</option>
        <option value="1" selected>Normal</option>
        <option value="4">Fast</option>
        <option value="16">Turbo</option>
      </select>
      <input id="anim-slider" type="range" min="0" max="1000" step="1" value="0" title="Trip progress" />
      <div id="anim-label">
        <span class="anim-label-main" id="anim-label-main">–</span>
        <span class="anim-label-sub" id="anim-label-sub"></span>
      </div>
    </div>
  </div>

  <footer>
    <span>Generated by route-recap · {{ provider_note }}</span>
    <span>{% if carto_key %}Map data © OpenStreetMap contributors · Tiles © CARTO{% else %}Map data © OpenStreetMap contributors{% endif %} · Leaflet</span>
  </footer>

  <script id="trip-data" type="application/json">{{ trip_json | safe }}</script>
{% if vendor_js %}
  <script>{{ vendor_js | safe }}</script>
{% else %}
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
{% endif %}
  <script>
    (function () {
      var data = JSON.parse(document.getElementById('trip-data').textContent);

      function esc(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function decodePolyline(str, precision) {
        precision = precision || 5;
        var index = 0, lat = 0, lng = 0, coords = [];
        var factor = Math.pow(10, precision), byte, shift, result;
        while (index < str.length) {
          shift = 0; result = 0;
          do { byte = str.charCodeAt(index++) - 63; result |= (byte & 0x1f) << shift; shift += 5; } while (byte >= 0x20);
          var dlat = (result & 1) ? ~(result >> 1) : (result >> 1);
          lat += dlat;
          shift = 0; result = 0;
          do { byte = str.charCodeAt(index++) - 63; result |= (byte & 0x1f) << shift; shift += 5; } while (byte >= 0x20);
          var dlng = (result & 1) ? ~(result >> 1) : (result >> 1);
          lng += dlng;
          coords.push([lat / factor, lng / factor]);
        }
        return coords;
      }
      function fmtTime(iso) {
        var d = new Date(iso);
        return isNaN(d) ? '' : d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      }
      var assets = data.assets || {};
      // Mid-drive, the road you were on reads better than the nearest landmark;
      // for an off-road spot the landmark is the meaningful one.
      function wpName(wp) {
        return wp.off_road
          ? (wp.name || wp.road || null)
          : (wp.road || wp.name || null);
      }

      // ---- one trip-ordered gallery of every photo ----
      // Strips are per-location, but the lightbox browses this single list, so
      // swiping past the last photo at a place continues into the next place
      // along the route instead of stopping dead.
      var allPhotos = [];    // [{key, asset, place, when}]
      var photoIndexOf = {}; // source-file key -> index in allPhotos
      (function buildGallery() {
        function add(files, place, when) {
          (files || []).forEach(function (f) {
            if (photoIndexOf[f] !== undefined) return;  // already indexed
            var a = assets[f];
            if (!a || !(a.thumb || a.url)) return;      // skip thumbs-less video
            photoIndexOf[f] = allPhotos.length;
            allPhotos.push({ key: f, asset: a, place: place, when: when });
          });
        }
        // Stops first so their richer label wins, then every waypoint in
        // trip order (which is what makes the gallery chronological).
        (data.stops || []).forEach(function (s, i) {
          add(s.source_files, s.name || ('Stop ' + (i + 1)), s.arrived_at);
        });
        (data.waypoints || []).forEach(function (wp) {
          var label = wpName(wp);
          if (!label) label = wp.off_road ? 'Off-road spot' : 'On the road';
          add(wp.source_files, label, wp.timestamp);
        });
      })();

      function assetStrip(files, limit) {
        var idxs = [], videos = [];
        (files || []).forEach(function (f) {
          var a = assets[f];
          if (!a) return;
          if (a.kind === 'video' && !a.thumb) videos.push({ asset: a, file: f });
